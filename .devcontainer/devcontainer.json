{
  "name": "Hacfard RemoteX",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Hacfard RemoteX Custom UI",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash server/bootstrap.sh",
  "postStartCommand": "bash server/auto-start.sh",
  "waitFor": "postCreateCommand",
  "remoteUser": "vscode",
  "shutdownAction": "stopContainer"
}
